from utils import ConfigManager

cfg = ConfigManager(config)

# Find (run, replicate) pairs that already have a simulated image on disk under
# <out_dir>/tmp/{run}/{replicate}/spot_img.tif — i.e. scenarios that were
# already generated by a previous `simulate_data` run. No simulation is
# re-triggered here: this file has no `simulate_data` rule, so if a run in
# your config doesn't already have an image present, it is simply skipped
# rather than regenerated.
RUN_WC, REP_WC = glob_wildcards(str(cfg.sim_img_template))

SAVANNAH_TARGETS = [
    str(cfg.spots_template).format(run=r, replicate=rep, decoder="savannah")
    for r, rep in zip(RUN_WC, REP_WC)
]


rule all:
    input:
        SAVANNAH_TARGETS,


rule run_savannah:
    input:
        c=cfg.codebook_file,
        i=cfg.sim_img_template,
    output:
        cfg.spots_template,
    wildcard_constraints:
        decoder="savannah",
    threads: cfg.savannah_threads
    conda:
        "envs/savannah.yaml"
    shell:
        "python scripts/run_savannah.py -c {input.c} -i {input.i} -o {output} -t {threads}"